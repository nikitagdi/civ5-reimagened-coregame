	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(ProjectDir)..\out\host\$(ConfigurationName)"
			IntermediateDirectory="$(ProjectDir)..\out\host\obj\$(ConfigurationName)"
			ConfigurationType="1"
			CharacterSet="2"
			WholeProgramOptimization="0"
			>
			<Tool
				Name="VCPreBuildEventTool"
			/>
			<Tool
				Name="VCCustomBuildTool"
			/>
			<Tool
				Name="VCXMLDataGeneratorTool"
			/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"
			/>
			<Tool
				Name="VCMIDLTool"
			/>
			<Tool
				Name="VCCLCompilerTool"
				Optimization="2"
				InlineFunctionExpansion="2"
				EnableIntrinsicFunctions="true"
				OmitFramePointers="false"
				WholeProgramOptimization="false"
				AdditionalIncludeDirectories="&quot;$(ProjectDir)src&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\CvGameCoreDLLUtil\include&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\CvGameDatabase\include&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\CvLocalization\include&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\FirePlace\include&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\FirePlace\include\FireWorks&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\ThirdPartyLibs\Lua51\include&quot;"
				PreprocessorDefinitions="WIN32;NDEBUG;_CONSOLE;FINAL_RELEASE;_CRT_SECURE_NO_WARNINGS;_SECURE_SCL=0;_HAS_ITERATOR_DEBUGGING=0"
				ExceptionHandling="1"
				RuntimeLibrary="2"
				BufferSecurityCheck="true"
				EnableFunctionLevelLinking="true"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				DebugInformationFormat="3"
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCPreLinkEventTool"
			/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="/STACK:4194304 /DELAYLOAD:lua51_Win32.dll /DELAYLOAD:&quot;CvGameDatabaseWin32Final Release.dll&quot; /DELAYLOAD:&quot;CvLocalizationWin32Final Release.dll&quot;"
				AdditionalDependencies="CvGameDatabaseWin32.lib CvLocalizationWin32.lib lua51_Win32.lib FireWorksWin32.lib winmm.lib dbghelp.lib delayimp.lib"
				OutputFile="$(OutDir)\civhost.exe"
				LinkIncremental="1"
				AdditionalLibraryDirectories="&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\CvGameDatabase\lib&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\CvLocalization\lib&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\ThirdPartyLibs\Lua51\lib&quot;;&quot;$(ProjectDir)..\..\LEKMOD_DLL\CvGameCoreDLL_Expansion2\FirePlace\lib&quot;"
				GenerateDebugInformation="true"
				ProgramDatabaseFile="$(OutDir)\civhost.pdb"
				SubSystem="1"
				LargeAddressAware="2"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				RandomizedBaseAddress="1"
				DataExecutionPrevention="0"
				TargetMachine="1"
			/>
			<Tool
				Name="VCALinkTool"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCBscMakeTool"
			/>
			<Tool
